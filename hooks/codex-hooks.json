{
	"description": "Each hook returns at once; classification runs in a detached worker. SessionStart may install the two runtime packages on first use, so it gets more time.",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/bin/adr-recorder.js\" codex hook",
						"timeout": 120
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/bin/adr-recorder.js\" codex hook",
						"timeout": 10
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/bin/adr-recorder.js\" codex hook",
						"timeout": 10
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/bin/adr-recorder.js\" codex hook",
						"timeout": 3
					}
				]
			}
		]
	}
}
